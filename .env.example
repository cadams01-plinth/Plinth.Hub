# ===== Supabase (London, eu-west-2) =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key: server-only, quarantined per SPEC §4.6. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===== Hub =====
NEXT_PUBLIC_HUB_URL=https://hub.plinthresource.com

# ===== SSO — Plinth Launch Token (SPEC §3) =====
# RSA private key, PKCS8 PEM, base64-encoded to survive env var newlines:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
PLINTH_SSO_PRIVATE_KEY_B64=
# Key id published in JWKS; bump on rotation (24 h dual-publish, SPEC §3/§10)
PLINTH_SSO_KID=plinth-sso-2026-07
# During rotation: previous PUBLIC key as a JSON JWK (with its old kid), else empty
PLINTH_SSO_PREVIOUS_JWK=

# ===== Stripe (Phase 2) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Anthropic — Ask Plinth (Phase 4) =====
ANTHROPIC_API_KEY=

# ===== Resend (Phase 6) =====
RESEND_API_KEY=

# ===== Cron =====
CRON_SECRET=

# ===== Demo suite app (apps/demo) =====
DEMO_APP_PORT=4000
DEMO_HUB_JWKS_URL=http://localhost:3000/.well-known/plinth-sso.json
DEMO_APP_SLUG=plinth-demo
